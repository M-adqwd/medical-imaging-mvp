# 单端口部署的运行配置。复制为 .env 后按需改，.env 不要提交。
APP_NAME=医学影像阅片与手术规划系统
API_PREFIX=/api/v1
DEBUG=false

# 单机 SQLite；库文件随包发布，开箱即有 3 例演示病例
DATABASE_URL=sqlite:///./miis.db

# DICOM 事实源：内置文件归档（随包 data/dicom）
DICOMWEB_BASE_URL=
DICOM_STORE_DIR=./data/dicom
DICOMWEB_VERIFY_TLS=false

# AI：留空即本地桩（/ai/infer 返回 503 ai_mode:stub）
AI_BASE_URL=
AI_TIMEOUT_SEC=30

IDEMPOTENCY_TTL_DAYS=7
SHARE_DEFAULT_TTL_DAYS=7
RATE_LIMIT_PER_MINUTE=600
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# —— 登录门禁 ——
# 口令留空时启动会随机生成一个并打印到控制台；正式对外请显式设置。
MIIS_WEB_USER=admin
MIIS_WEB_PASS=
# Cookie 签名密钥，留空则每次重启随机生成（重启即掉登录态）。生成：openssl rand -hex 24
MIIS_WEB_SECRET=
