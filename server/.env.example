# 应用
APP_NAME=医学影像阅片与手术规划系统
API_PREFIX=/api/v1
DEBUG=false

# 数据库（生产用 PostgreSQL；开发默认 SQLite）
DATABASE_URL=sqlite:///./miis.db
# DATABASE_URL=postgresql+psycopg://miis:miis_dev@localhost:5432/miis

# 契约 §5.4：幂等键窗口（天）
IDEMPOTENCY_TTL_DAYS=7

# 契约 §1.7：共享链接默认有效期（天）
SHARE_DEFAULT_TTL_DAYS=7

# 限流（次/分钟/用户）
RATE_LIMIT_PER_MINUTE=600

# DICOM 事实源：Orthanc DICOMweb 地址。留空则使用内置文件存储（.dicomstore/）
DICOMWEB_BASE_URL=
DICOMWEB_VERIFY_TLS=false

# AI 推理服务（MONAI Deploy）。留空则看 AI_LOCAL_INFER：开了走本地真实推理，没开是本地桩
AI_BASE_URL=
AI_TIMEOUT_SEC=30
# 本地真实分割（TotalSegmentator，nnU-Net CPU --fast）。仅在 AI_BASE_URL 为空时生效。
# 首跑会下载权重（数 GB），CPU 推理一次以分钟计；权重目录 ~/.totalsegmentator/
# AI_LOCAL_INFER=1

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]